# Network
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# Security
# Use a long, random value in every environment.
JWT_SECRET=replace-with-a-long-random-secret

# Storage
DB_PATH=data/myfrends.db

# Optional default LLM configuration.
# Users can also configure their own provider settings in the app.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
